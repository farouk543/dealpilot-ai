# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Vision (Groq has no vision-capable model currently; using Gemini for this service only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Interior design rendering (self-hosted Stable Diffusion 1.5 on local GPU, no API key needed)
SD_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# Shared database (SQLite file mounted into every service container)
DATABASE_URL=sqlite:////data/dealpilot.db

# Service-to-service URLs (used by orchestrator; overridden per-container in docker-compose)
INTAKE_SERVICE_URL=http://intake:8000
DOCUMENT_INTEL_SERVICE_URL=http://document-intel:8000
VISION_SERVICE_URL=http://vision:8000
MARKET_SERVICE_URL=http://market:8000
FINANCIAL_ENGINE_SERVICE_URL=http://financial-engine:8000
RISK_SERVICE_URL=http://risk:8000
OFFER_SERVICE_URL=http://offer:8000
DUE_DILIGENCE_SERVICE_URL=http://due-diligence:8000

# External data
DVF_API_BASE_URL=https://api.cquest.org/dvf
